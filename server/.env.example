# Copiar a .env y ajustar. Aquí no va ningún secreto: la contraseña se fija con scripts/set-password.mjs.

# Dónde escucha (solo local; hacia fuera lo publica el túnel de Cloudflare)
MYMUSIC_HOST=127.0.0.1
MYMUSIC_PORT=3100

# Memoria para el audio: tope total y tope por canción, en MB
MYMUSIC_CACHE_MB=300
MYMUSIC_TRACK_MAX_MB=150

# yt-dlp: intérprete de Python que lo tiene instalado y runtime JS para los retos de YouTube
YTDLP_PYTHON=/data/data/com.termux/files/home/ytdlp-venv/bin/python
YTDLP_JS_RUNTIME=node
# Opcionales: forzar cliente de YouTube y archivo de cookies (en la IP de casa no hacen falta)
# YTDLP_PLAYER_CLIENT=
# YTDLP_COOKIES=
